[TEMPLATE]
# Copy this file to .env and fill in your values. .env is gitignored.
# The Gemini API key pre-fills the default AI provider in Settings.
VITE_GEMINI_KEY=

# Supabase Auth (cloud login). Required for sign in / sign up to work:
# Project Settings -> API. URL is the Project URL, key is the anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Umbra OS backend (optional — if running the backend, set this to connect the frontend to it)
# Leave unset or empty to fall back to direct cloud AI calls.
VITE_BACKEND_URL=http://127.0.0.1:8787

# Samsung SmartThings (Smart Home tab). Create a personal access token at
# https://account.smartthings.com/tokens (scopes: devices, rooms; control for commands).
# In the packaged Electron app the token is read by the MAIN process:
#   SMARTTHINGS_TOKEN=...
# For plain `npm run dev` in the browser (uses the Vite proxy, which injects
# the Authorization header server-side) you can also set:
#   VITE_SMARTTHINGS_TOKEN=...
VITE_SMARTTHINGS_TOKEN=
VITE_SMARTTHINGS_URL=https://api.smartthings.com
